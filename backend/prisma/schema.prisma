generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlserver"
    url=env("DATABASE_URL)
}



model Tenant {
    id          Int     @id @default(autoincrement())
    name        String 
    email       String  @unique
    phone       String  
    unitNo      String
    movedInDate DateTime
    createdAt DateTime @default(now())
}